pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    triggers {
        pollSCM('H/2 * * * *')   // checks every 2 minutes
    }

    environment {
        GIT_REPO = 'https://github.com/awsdevopssri/Future.git'
        GIT_BRANCH = 'feature-ep2-task-1'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: "${GIT_BRANCH}", url: "${GIT_REPO}"
            }
        }

        stage('Check Python') {
            steps {
                bat '''
                echo Checking Python installation...

                where python
                if %ERRORLEVEL% NEQ 0 (
                    echo Python not found! Please install Python and add to PATH
                    exit /b 1
                )

                python --version
                '''
            }
        }

        stage('Setup Virtual Env (if possible)') {
            steps {
                bat '''
                echo Trying to create virtual environment...

                python -m venv venv

                IF EXIST venv (
                    echo Virtual environment created successfully

                    call venv\\Scripts\\activate

                    python -m pip install --upgrade pip

                    if exist requirements.txt (
                        pip install -r requirements.txt
                    ) else (
                        echo No requirements.txt found
                    )
                ) ELSE (
                    echo venv not available → using system Python
                )
                '''
            }
        }

        stage('Run Application') {
            steps {
                bat '''
                IF EXIST venv (
                    call venv\\Scripts\\activate
                )
                python app.py
                '''
            }
        }

        stage('Run Tests') {
            steps {
                bat '''
                IF EXIST venv (
                    call venv\\Scripts\\activate
                )
                python -m unittest discover
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Build SUCCESS'
        }
        failure {
            echo '❌ Build FAILED'
        }
    }
}